# Exemple du fichier .env généré par install.ps1 (le vrai .env est gitignoré).
# Ne jamais versionner .env : il contient des chemins propres au poste ET des jetons.

# ---------------------------------------------------------------------------
# Section gérée par install.ps1 — réécrite à chaque installation.
# ---------------------------------------------------------------------------

PROJECT_ROOT=D:\github\storage_analysis

# Interpréteur hôte retenu pour créer le venv
BASE_PYTHON=C:\Users\moi\AppData\Local\Programs\Python\Python313\python.exe
BASE_PYTHON_VERSION=3.13.7
BASE_PYTHON_SOURCE=system

# Interpréteur à utiliser pour tout lancement de l'application
VENV_PYTHON=D:\github\storage_analysis\.venv\Scripts\python.exe
VENV_DIR=D:\github\storage_analysis\.venv

# ---------------------------------------------------------------------------
# Clés ajoutées à la main — install.ps1 les préserve lors d'une réinstallation.
# ---------------------------------------------------------------------------

# Où chercher les clones locaux (séparateur : point-virgule)
REPO_ROOTS=D:\github;D:\gitlab;D:\sobrieau

# ── Courtier du lab (oauth-hub) — voie recommandée ─────────────────────────
#   Un seul domaine suffit : l'issuer Keycloak et l'API du courtier s'en
#   déduisent. Aucun identifiant d'application OAuth à créer côté client.
#   Prérequis côté lab : le client Keycloak existe, et son client_id figure
#   dans KEYCLOAK_TRUSTED_CLIENTS du .env d'oauth-hub.
LAB_DOMAIN=
HUB_CLIENT_ID=storage-analysis
HUB_PORT=8765
#   Surcharges si le routage du lab diffère :
# HUB_ISSUER=https://mon-lab/auth/realms/ssolab
# HUB_API=https://mon-lab/oauth-hub-api
#   Écrit par « repos login » — session de lab, à ne pas partager.
LAB_REFRESH_TOKEN=

# ── GitHub en direct — repli hors connexion au cadriciel ───────────────────
#   Le Client ID est PUBLIC par construction : il peut être partagé et versionné.
#   Le Client Secret n'est jamais nécessaire, PKCE le remplace.
#   Enregistrez côté GitHub l'URI de rappel http://127.0.0.1:8765/callback
#   et laissez « Enable Device Flow » DÉCOCHÉ.
GITHUB_CLIENT_ID=

#   Écrits par « repos login » — ne pas remplir à la main.
#   Un jeton personnel (PAT) reste accepté ici si vous préférez.
GITHUB_TOKEN=
GITHUB_TOKEN_SOURCE=
GITHUB_TOKEN_SCOPES=

# GitLab — instance auto-hébergée ou gitlab.com.
#   Portées : « read_api » pour lister, « api » pour archiver et supprimer.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# Namespaces protégés contre « repos rm-remote », motifs glob séparés par des
# virgules. Fortement recommandé pour les espaces partagés avec des collègues :
#   FORGE_PROTECTED=mon-groupe,mon-groupe/*
FORGE_PROTECTED=
